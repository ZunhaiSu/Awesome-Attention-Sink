{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attention Sink migrated literature catalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "identifiers", "date", "publication", "links", "classification", "legacy_tags", "legacy_new_flag", "verification", "provenance"],
    "additionalProperties": false,
    "properties": {
      "id": {"type": "string", "pattern": "^as-"},
      "title": {"type": "string", "minLength": 1},
      "identifiers": {"type": "object", "additionalProperties": {"type": "string"}},
      "date": {
        "type": "object", "required": ["value", "precision"], "additionalProperties": false,
        "properties": {
          "value": {"type": "string", "pattern": "^20[0-9]{2}(-[0-9]{2})?$"},
          "precision": {"enum": ["year", "month"]}
        }
      },
      "publication": {
        "type": "object", "required": ["label", "verification"],
        "properties": {"label": {"type": "string"}, "verification": {"const": "imported_not_rechecked"}}
      },
      "links": {
        "type": "object", "required": ["paper", "original"],
        "properties": {"paper": {"type": "string", "format": "uri"}, "original": {"type": "string", "format": "uri"}}
      },
      "classification": {"$ref": "#/$defs/labels"},
      "legacy_tags": {"$ref": "#/$defs/labels"},
      "legacy_new_flag": {"type": "boolean"},
      "verification": {
        "type": "object", "required": ["classification", "review_in_this_update"],
        "properties": {"classification": {"const": "legacy_imported"}, "review_in_this_update": {"const": "not_reassessed"}}
      },
      "provenance": {
        "type": "object", "required": ["source_id", "sheet", "row"],
        "properties": {"source_id": {"type": "string"}, "sheet": {"type": "string"}, "row": {"type": "integer", "minimum": 3}}
      }
    }
  },
  "$defs": {
    "labels": {
      "type": "object", "required": ["architectures", "utilization", "interpretation", "mitigation", "applications"],
      "additionalProperties": false,
      "properties": {
        "architectures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "utilization": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "interpretation": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "mitigation": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "applications": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
